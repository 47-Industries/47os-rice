#!/usr/bin/env bash
# ============================================================
#   47OS Gaming Setup
#   Turns a 47OS box into a gaming machine: Steam + Proton,
#   Lutris, Heroic, GameMode, MangoHud, controller support.
#
#   Run: 47os-gaming            (install / repair, idempotent)
#        47os-gaming --check    (report only, changes nothing)
#
#   Deliberately NOT part of install.sh: this pulls several GB.
#   A desktop rice should not force that on someone who wants a
#   panel and a wallpaper.
# ============================================================
set -uo pipefail

CYAN='\033[1;36m'; WHITE='\033[1;97m'; GREEN='\033[1;32m'
YELLOW='\033[1;33m'; RED='\033[1;31m'; RESET='\033[0m'
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
errors=0
step=0; total=8

progress() { step=$((step+1)); echo -e "\n${CYAN}[$step/$total]${WHITE} $1${RESET}"; }
ok()   { echo -e "  ${GREEN}$1${RESET}"; }
warn() { echo -e "  ${YELLOW}WARNING: $1${RESET}"; }
fail() { echo -e "  ${RED}FAILED: $1${RESET}"; errors=$((errors+1)); }
have() { command -v "$1" >/dev/null 2>&1; }

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}Don't run as root. Run as your normal user — sudo is used where needed.${RESET}"
    exit 1
fi

# ---------------------------------------------------------------- check mode
report() {
    echo -e "${CYAN}47OS gaming status${RESET}"
    for p in steam lutris gamemoderun mangohud vulkaninfo 47os-game; do
        printf '  %-12s ' "$p"
        have "$p" && echo -e "${GREEN}present${RESET}" || echo -e "${YELLOW}missing${RESET}"
    done
    printf '  %-12s ' heroic
    flatpak list --app 2>/dev/null | grep -q heroicgameslauncher && echo -e "${GREEN}present${RESET}" || echo -e "${YELLOW}missing${RESET}"
    printf '  %-12s ' protonup
    flatpak list --app 2>/dev/null | grep -q pupgui2 && echo -e "${GREEN}present${RESET}" || echo -e "${YELLOW}missing${RESET}"
    printf '  %-12s ' xpadneo
    dkms status 2>/dev/null | grep -qi xpadneo && echo -e "${GREEN}built${RESET}" || echo -e "${YELLOW}missing${RESET}"
    echo
    have 47os-game && 47os-game --status
}
[ "${1:-}" = "--check" ] && { report; exit 0; }

echo -e "${CYAN}"
echo "================================================"
echo "  47OS Gaming Setup"
echo "================================================"
echo -e "${RESET}"

export DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------- 1. 32-bit
progress "Enabling 32-bit support (Steam needs it)"
if dpkg --print-foreign-architectures | grep -q i386; then
    ok "i386 already enabled"
else
    sudo dpkg --add-architecture i386 && sudo apt-get update -qq && ok "i386 enabled" || fail "could not enable i386"
fi

# ------------------------------------------------------------- 2. packages
progress "Installing the gaming stack"
echo "steam steam/question select I AGREE" | sudo debconf-set-selections
echo "steam steam/license note ''" | sudo debconf-set-selections
# One at a time on purpose: a single unavailable name in a batch aborts the
# ENTIRE apt transaction and installs nothing. Learned that the loud way.
PKGS=(
  steam-installer lutris
  gamemode libgamemode0 libgamemodeauto0 libgamemodeauto0:i386
  mangohud goverlay
  vulkan-tools libvulkan1 libvulkan1:i386
  mesa-vulkan-drivers mesa-vulkan-drivers:i386
  libgl1-mesa-dri:i386 libglx-mesa0:i386
  dkms build-essential
  joystick jstest-gtk evtest
  cabextract p7zip-full unzip curl git
  libasound2-plugins:i386 libsdl2-2.0-0:i386
)
sudo apt-get install -y -qq "linux-headers-$(uname -r)" >/dev/null 2>&1 \
    && ok "linux-headers-$(uname -r)" || warn "kernel headers unavailable (DKMS drivers will not build)"
for p in "${PKGS[@]}"; do
    if sudo apt-get install -y -qq "$p" >/tmp/47os-gaming-apt.log 2>&1; then
        ok "$p"
    else
        warn "$p — $(grep -m1 -E '^E:' /tmp/47os-gaming-apt.log)"
    fi
done

# ------------------------------------------------- 3. controllers over BT
progress "Controller support (Xbox / PlayStation / Switch Pro)"
if dkms status 2>/dev/null | grep -qi xpadneo; then
    ok "xpadneo already built"
elif [ -e /lib/modules/"$(uname -r)"/build ]; then
    sudo dkms remove hid-xpadneo/ --all >/dev/null 2>&1   # clear a half-failed retry
    rm -rf /tmp/xpadneo
    # FULL clone, never --depth 1: xpadneo's Makefile derives VERSION from
    # `git describe --tags`, and a shallow clone has no tags, so the build dies
    # with "No names found, cannot describe anything". Cost an install once.
    if git clone -q https://github.com/atar-axis/xpadneo.git /tmp/xpadneo; then
        sudo git config --global --add safe.directory /tmp/xpadneo
        if (cd /tmp/xpadneo && sudo ./install.sh >/tmp/47os-xpadneo.log 2>&1) \
           && dkms status 2>/dev/null | grep -qi xpadneo; then
            ok "xpadneo installed (Xbox controllers over Bluetooth, with rumble)"
        else
            warn "xpadneo build failed — see /tmp/47os-xpadneo.log (Xbox pads still work, without rumble)"
        fi
    else
        warn "could not fetch xpadneo (offline?)"
    fi
    # Xbox controller firmware 5.x needs uhid present at boot.
    if modinfo uhid >/dev/null 2>&1; then
        echo uhid | sudo tee /etc/modules-load.d/xpadneo.conf >/dev/null
        sudo modprobe uhid 2>/dev/null
    fi
else
    warn "no kernel headers — skipping xpadneo"
fi

# Xbox pads drop off Bluetooth every few seconds unless ERTM is disabled.
if ! grep -qs disable_ertm /etc/modprobe.d/47os-bluetooth-xbox.conf; then
    echo "options bluetooth disable_ertm=1" | sudo tee /etc/modprobe.d/47os-bluetooth-xbox.conf >/dev/null
    ok "Bluetooth ERTM disabled (stops Xbox pads disconnecting)"
else
    ok "Bluetooth ERTM already disabled"
fi
echo 1 | sudo tee /sys/module/bluetooth/parameters/disable_ertm >/dev/null 2>&1

# Valve's device rules — DualSense/DualShock/Switch Pro/Steam Deck controllers
# need these to be reachable without root.
if sudo curl -fsSL --max-time 20 -o /etc/udev/rules.d/60-steam-input.rules \
      https://raw.githubusercontent.com/ValveSoftware/steam-devices/master/60-steam-input.rules; then
    sudo udevadm control --reload-rules && sudo udevadm trigger
    ok "Steam controller udev rules installed"
else
    warn "could not fetch Steam udev rules (offline?)"
fi

# ------------------------------------------------------- 4. gamemode wiring
progress "GameMode tuning"
if [ -f "$REPO_DIR/system/gaming/gamemode.ini" ]; then
    sudo cp "$REPO_DIR/system/gaming/gamemode.ini" /etc/gamemode.ini && ok "/etc/gamemode.ini"
    sudo install -m 755 "$REPO_DIR/system/gaming/47os-gamemode-hook" /usr/local/bin/47os-gamemode-hook \
        && ok "gamemode hook (pauses Battery Saver while a game runs)"
else
    warn "gamemode config missing from repo"
fi
sudo usermod -aG gamemode "$USER" 2>/dev/null

# --------------------------------------------------------- 5. overlay config
progress "MangoHud overlay"
mkdir -p "$HOME/.config/MangoHud"
if [ -f "$REPO_DIR/config/mangohud/MangoHud.conf" ]; then
    cp "$REPO_DIR/config/mangohud/MangoHud.conf" "$HOME/.config/MangoHud/MangoHud.conf" \
        && ok "overlay configured (Right-Shift + F12 toggles it)"
fi

# ------------------------------------------------------------ 6. launcher
progress "Installing the 47os-game launcher"
sudo install -m 755 "$SCRIPT_DIR/47os-game" /usr/local/bin/47os-game && ok "47os-game"

# ------------------------------------------------------- 7. flatpak extras
progress "ProtonUp-Qt and Heroic (Epic / GOG)"
if have flatpak; then
    flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1
    flatpak install -y --user --noninteractive flathub net.davidotek.pupgui2 >/dev/null 2>&1 \
        && ok "ProtonUp-Qt (installs GE-Proton for the hard games)" || warn "ProtonUp-Qt install failed"
    flatpak install -y --user --noninteractive flathub com.heroicgameslauncher.hgl >/dev/null 2>&1 \
        && ok "Heroic Games Launcher" || warn "Heroic install failed"
else
    warn "flatpak not present — skipping"
fi

# --------------------------------------------------------------- 8. verify
progress "Verifying"
report

echo
if [ "$errors" -eq 0 ]; then
    echo -e "${GREEN}Gaming stack ready.${RESET}"
else
    echo -e "${YELLOW}Finished with $errors hard failure(s) — see above.${RESET}"
fi
cat <<'TIP'

  Steam       : log in, then Settings > Compatibility > enable Steam Play
                for all other titles. That is what runs Windows games.
  Launch opts : paste this into a game's launch options on a laptop like
                this one so it uses the NVIDIA chip and not the Intel one:

                  47os-game %command%

  Overlay     : Right-Shift + F12 toggles the FPS/temp overlay.
  Controllers : pair over Bluetooth in Settings, or plug in USB. Test with
                jstest-gtk.
TIP
